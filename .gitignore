cat > .gitignore << 'EOF'
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE and editor
.vscode/
.idea/
*.swp

# Operating system
.DS_Store
Thumbs.db

# Testing and coverage
coverage/

# Local configuration
*.local
EOF